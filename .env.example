# Supabase — powers sign-in on /me (email magic link by default).
# Copy this file to .env.local for dev, and add the same two vars in Vercel → Settings → Environment Variables.
# Get them from: Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: show "Continue with Google" as well as the magic link.
# Requires Google Cloud OAuth credentials in Supabase (Authentication → Providers → Google),
# which currently needs a card-verified Google Cloud account. Leave unset to stay magic-link only.
# VITE_ENABLE_GOOGLE=true
